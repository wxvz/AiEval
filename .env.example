MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aieval
PORT=3000

# LLM providers (Ollama is probed first; set any cloud key as fallback)
# Local Ollama: run `ollama serve` (or open the Ollama app on macOS), then pull models
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Sent to OpenRouter for analytics / allow-listing (set to your deployed app URL in production)
OPENROUTER_HTTP_REFERER=http://localhost:4200
OPENROUTER_APP_TITLE=AiEval
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# balanced = small answer models + stronger judge (default); fast = all small models
# You can also change this at runtime in the app: Settings → Models (until API restart)
LLM_PRESET=balanced

# Optional overrides (comma-separated provider:model)
LLM_ANSWER_MODELS=ollama:llama3.2:3b,ollama:qwen2.5:3b,ollama:gemma2:2b
LLM_JUDGE_MODEL=groq:openai/gpt-oss-120b

# Rate limiting (use LLM_CONCURRENCY=1 with Ollama on slower machines or OpenRouter free / openrouter/free)
LLM_CONCURRENCY=3
LLM_INTER_CALL_DELAY_MS=200
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_MS=500
# Node fetch defaults to a 5-minute timeout; raise for slow local models
LLM_REQUEST_TIMEOUT_MS=900000
# After this many ms on Ollama, the UI asks whether to switch to a cloud provider
LLM_SLOW_FALLBACK_MS=180000

# Structured logging
LOG_LEVEL=info
# json | pretty | text (text = "INFO: message" in the terminal; file stays NDJSON)
LOG_FORMAT=json
 # (Optional: logs/server.ndjson for JSON, logs/server.log for text)
LOG_FILE=
LOG_PROMPTS=false

# Print MongoDB + LLM provider status when the API starts (set false to skip)
STARTUP_PREFLIGHT=true

# Optional API Bearer token. When set, required for /api/evaluations, /api/learn-chat,
# and PATCH /api/settings. Prefer Authorization: Bearer <token> for non-SSE requests.
# Browser EventSource cannot set headers, so automate/stream uses ?api_token= (visible in
# proxy / access logs; server request logger redacts it). Leave empty for local dev.
AIEVAL_API_TOKEN=
# Set true when the API sits behind a reverse proxy (trusts X-Forwarded-* for client IP)
TRUST_PROXY=false

# Learn page tutor chat (n8n production webhook; leave empty to disable /api/learn-chat)
LEARN_CHAT_WEBHOOK_URL=https://n8n.wxvz.eu/webhook/learn-chat
# Shared secret for Express → n8n (header X-Learn-Chat-Secret). Required when URL is set.
# On n8n (free plan): create a Header Auth credential named for header "X-Learn-Chat-Secret"
# with this same value, and attach it to the Learn chat Webhook (Authentication = Header Auth).
# Do not rely on n8n Variables ($vars) — that needs a paid plan.
LEARN_CHAT_WEBHOOK_SECRET=
# Optional soft rate limit for /api/learn-chat (requests per IP or sessionId per minute)
LEARN_CHAT_RATE_LIMIT_PER_MINUTE=30
