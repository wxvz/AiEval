{
  "name": "ai-eval",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "server": "tsx watch server/src/index.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm start\"",
    "build": "ng build",
    "build:server": "tsc -p server/tsconfig.build.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "vitest run server/src",
    "ci": "npm run build && npm run build:server && npx vitest run server/src && npm test -- --no-watch"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "npm": ">=11.12.0"
  },
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/forms": "^21.2.13",
    "@angular/platform-browser": "^21.2.13",
    "@angular/router": "^21.2.13",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mongodb": "^6.16.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.11",
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@types/bootstrap": "^5.2.11",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.6"
  }
}
